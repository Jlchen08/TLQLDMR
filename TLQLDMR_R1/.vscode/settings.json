{
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.autoBuild.interval": 500,
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.view.pdf.refocus": false,
  "latex-workshop.view.pdf.internal.synctex.keybinding": "double-click",
  "latex-workshop.view.pdf.tab.useNewGroup": true,
  "latex-workshop.view.pdf.tab.editorGroup": "right",
  "latex-workshop.synctex.afterBuild.enabled": true,
  "latex-workshop.message.error.show": false,
  "latex-workshop.message.warning.show": false,
  "latex-workshop.message.badbox.show": "none",
  "files.autoSave": "off",
  "files.autoSaveDelay": 1000,
  "git.autoRepositoryDetection": false,
  "git.openRepositoryInParentFolders": "never",
  "git.scanRepositories": [
    "."
  ],
  "git.repositoryScanMaxDepth": 0,
  "git.repositoryScanIgnoredFolders": [
    "node_modules",
    "build",
    "build_refcheck",
    "data",
    "experiment1",
    "experiment2",
    "experiment3",
    "experiment4",
    "experiment5"
  ],
  "[latex]": {
    "editor.wordWrap": "on",
    "editor.wordWrapColumn": 120,
    "editor.wrappingIndent": "same"
  },
  "latex-workshop.latex.clean.fileTypes": [
    "aux",
    "bbl",
    "blg",
    "fdb_latexmk",
    "fls",
    "log",
    "out",
    "synctex.gz",
    "toc",
    "abs"
  ],
  "kiroAgent.configureMCP": "Disabled",
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-pdf",
      "command": "bash",
      "args": [
        "-lc",
        "exec latexmk \"$@\"",
        "latexmk",
        "-cd",
        "-pdf",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-halt-on-error",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ]
    },
    {
      "name": "latexmk-system",
      "command": "latexmk",
      "args": [
        "-cd",
        "-pdf",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-halt-on-error",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (pdfLaTeX)",
      "tools": [
        "latexmk-pdf"
      ]
    },
    {
      "name": "latexmk (system PATH)",
      "tools": [
        "latexmk-system"
      ]
    }
  ],
  "latex-workshop.latex.build.fromFolder": "",
  "latex-workshop.latex.build.enableMagicComments": true,
  "latex-workshop.latex.recipe.default": "first"
}
